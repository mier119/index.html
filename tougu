<script>
(function () {
    'use strict';
    function $(id) { return document.getElementById(id); }
    function addCls(el, c) { if (el && (' ' + el.className + ' ').indexOf(' ' + c + ' ') === -1) el.className += ' ' + c; }
    function rmCls(el, c) { if (el) el.className = (' ' + el.className + ' ').replace(' ' + c + ' ', ' ').replace(/^\s+|\s+$/g, ''); }
    function addEv(el, type, fn) { if (el) el.addEventListener ? el.addEventListener(type, fn, false) : el.attachEvent('on' + type, fn); }

    var pageStack = ['page-home'];
    var allPages = document.querySelectorAll('.page');
    var allTabs  = document.querySelectorAll('.app-tab');

    function renderPage(pageId) {
        for (var i = 0; i < allPages.length; i++) rmCls(allPages[i], 'active');
        if ($(pageId)) addCls($(pageId), 'active');
        for (var j = 0; j < allTabs.length; j++) {
            if (allTabs[j].getAttribute('data-page') === pageId) addCls(allTabs[j], 'active');
            else rmCls(allTabs[j], 'active');
        }
    }

    window.switchTab = function(pageId) {
        var idx = -1;
        for (var i = 0; i < pageStack.length; i++) { if (pageStack[i] === pageId) { idx = i; break; } }
        if (idx !== -1) pageStack = pageStack.slice(0, idx + 1);
        else pageStack.push(pageId);
        renderPage(pageId);
        window.scrollTo(0, 0);
    };

    window.goBackPage = function() {
        if (pageStack.length > 1) {
            pageStack.pop();
            renderPage(pageStack[pageStack.length - 1]);
            window.scrollTo(0, 0);
        }
    };

    window.openModal = function(id) { if ($(id)) addCls($(id), 'show'); };
    window.closeModal = function(id) { if ($(id)) rmCls($(id), 'show'); };
    window.openTagModal = function(name) {
        if ($('tag-modal-title')) $('tag-modal-title').innerText = '标签 ' + name;
        if ($('tag-modal-text')) $('tag-modal-text').innerText = '标签：' + name;
        window.openModal('modal-tag');
    };

    var masks = document.querySelectorAll('.modal-mask');
    for (var k = 0; k < masks.length; k++) {
        addEv(masks[k], 'click', function(e) {
            if ((e.target || e.srcElement) === this) rmCls(this, 'show');
        });
    }

    var audio = $('bgmAudio');
    var musicBtn = $('musicBtn');
    var isPlaying = false;

    function toggleMusic(e) {
        if (e) { e.preventDefault(); e.stopPropagation(); }
        if (!audio) return;
        if (isPlaying) {
            audio.pause();
            musicBtn.innerHTML = '♫';
            musicBtn.style.color = '#9c8b73';
            isPlaying = false;
        } else {
            var p = audio.play();
            if (p !== undefined) {
                p.then(function() {
                    musicBtn.innerHTML = '♪';
                    musicBtn.style.color = '#c9a36b';
                    isPlaying = true;
                }).catch(function() {});
            } else {
                musicBtn.innerHTML = '♪';
                musicBtn.style.color = '#c9a36b';
                isPlaying = true;
            }
        }
    }

    addEv(musicBtn, 'click', toggleMusic);
    addEv(musicBtn, 'touchend', toggleMusic);

    var firstTap = false;
    addEv(document, 'touchstart', function() {
        if (firstTap) return;
        firstTap = true;
        if (!isPlaying) {
            var p = audio.play();
            if (p !== undefined) {
                p.then(function() {
                    musicBtn.innerHTML = '♪';
                    musicBtn.style.color = '#c9a36b';
                    isPlaying = true;
                }).catch(function(){});
            }
        }
    }, false);

    renderPage('page-home');
})();
</script>
</body>
